{
  "manifest_version": 3,
  "name": "Chzzk Ambient Mode",
  "version": "1.2.1",
  "description": "치지직 플레이어 뒤에 유튜브 앰비언트 모드 같은 글로우를 그립니다.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "치지직 앰비언트" },
  "content_scripts": [
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
